---
import { Image } from 'astro:assets';
import Todo from '../Todo.astro';
import { clientLogos, googleReviews } from '../../data/trust';
const g = googleReviews;
const GoogleTag = g.url ? 'a' : 'div';
---
<section class="trust" aria-label="Ils nous font confiance">
  <div class="wrap">
    <div class="trust-box">
      <GoogleTag class="trust-google" {...(g.url ? { href: g.url, target: '_blank', rel: 'noopener', 'data-cta': 'trust-google' } : {})}>
        <svg class="trust-g" viewBox="0 0 48 48" aria-hidden="true"><path fill="#FFC107" d="M43.6 20.5H42V20H24v8h11.3C33.7 32.7 29.2 36 24 36c-6.6 0-12-5.4-12-12s5.4-12 12-12c3.1 0 5.8 1.2 7.9 3.1l5.7-5.7C34 6.1 29.3 4 24 4 12.9 4 4 12.9 4 24s8.9 20 20 20 20-8.9 20-20c0-1.3-.1-2.4-.4-3.5z"/><path fill="#FF3D00" d="m6.3 14.7 6.6 4.8C14.7 15.1 19 12 24 12c3.1 0 5.8 1.2 7.9 3.1l5.7-5.7C34 6.1 29.3 4 24 4 16.3 4 9.7 8.3 6.3 14.7z"/><path fill="#4CAF50" d="M24 44c5.2 0 9.9-2 13.4-5.2l-6.2-5.2C29.2 35.1 26.7 36 24 36c-5.2 0-9.6-3.3-11.3-8l-6.5 5C9.5 39.6 16.2 44 24 44z"/><path fill="#1976D2" d="M43.6 20.5H42V20H24v8h11.3c-.8 2.2-2.2 4.2-4.1 5.6l6.2 5.2C37 39.2 44 34 44 24c0-1.3-.1-2.4-.4-3.5z"/></svg>
        <div>
          <div class="trust-rating">
            {g.rating ? <strong>{g.rating}/5</strong> : <Todo label="note" />}
            {g.rating && <span class="trust-stars" aria-hidden="true">★★★★★</span>}
          </div>
          <div class="trust-count">{g.count ? `${g.count} avis sur Google` : <Todo label="nombre d'avis Google" />}</div>
        </div>
      </GoogleTag>

      <div class="trust-sep" aria-hidden="true"></div>

      <div class="trust-clients">
        <p class="trust-label">Ils nous ont confié leurs projets</p>
        <ul class="trust-logos">
          {clientLogos.map((c) => (
            <li>
              {c.logo
                ? <Image src={c.logo} alt={c.name} height={40} class="trust-logo" />
                : <span class="trust-ph"><span class="trust-ph-name">{c.name}</span><Todo label="logo" /></span>}
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .trust{background:var(--bg);padding:0 0 4rem;position:relative;z-index:2}
  .trust-box{display:flex;flex-direction:column;gap:1.5rem;background:var(--bg2);border:1px solid var(--border);border-radius:1.8rem;padding:1.5rem}
  .trust-google{display:flex;align-items:center;gap:.9rem;flex-shrink:0}
  .trust-g{width:40px;height:40px;background:#fff;border-radius:50%;padding:8px;flex-shrink:0}
  .trust-rating{display:flex;align-items:center;gap:.5rem;flex-wrap:wrap;font-family:'Bricolage Grotesque',sans-serif;font-size:1.15rem}
  .trust-stars{color:#fbbf24;letter-spacing:.08em;font-size:.95rem}
  .trust-count{font-size:.78rem;color:rgba(255,255,255,.55);margin-top:.2rem}
  .trust-sep{height:1px;background:var(--border)}
  .trust-label{font-size:.66rem;letter-spacing:.12em;text-transform:uppercase;color:rgba(255,255,255,.6);font-weight:700;margin-bottom:.8rem}
  .trust-logos{list-style:none;display:grid;grid-template-columns:repeat(2,1fr);gap:.6rem}
  .trust-ph{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:.3rem;min-height:64px;height:100%;padding:.5rem .6rem;text-align:center;border-radius:1rem;background:rgba(255,255,255,.03);border:1px solid var(--border)}
  .trust-ph-name{font-family:'Bricolage Grotesque',sans-serif;font-weight:700;font-size:.82rem;color:rgba(255,255,255,.55)}
  .trust-ph :global(.todo){font-size:.58rem}
  .trust-logos :global(.trust-logo){height:40px;width:auto;opacity:.75;filter:grayscale(1) brightness(1.6)}
  @media (min-width:960px){
    .trust{margin-top:-2rem}
    .trust-box{flex-direction:row;align-items:center;gap:2.2rem;padding:1.6rem 2.2rem}
    .trust-sep{width:1px;height:64px}
    .trust-clients{flex:1}
    .trust-logos{grid-template-columns:repeat(5,1fr)}
  }
</style>
