---
import { Image } from 'astro:assets';
import kmm from '../../assets/realisations/kmm-terminal.png';
import bisou from '../../assets/realisations/bisou-vole-home.jpg';
import paul from '../../assets/paul.jpeg';
---
<section id="hero" aria-labelledby="hero-title">
  <div class="wrap hero-grid">
    <div class="hero-copy">
      <p class="hero-badge">
        <span class="hero-dot" aria-hidden="true"></span>
        Outils métier · Web-apps · Automatisation IA
      </p>
      <h1 id="hero-title" class="hero-h1">
        Des outils web et IA sur mesure pour <em>faire gagner du temps</em> à votre entreprise
      </h1>
      <p class="hero-sub">
        Pour les PME, fondateurs et startups. Un site livré dès 1 semaine, un outil métier dès 2 semaines,
        avec un seul interlocuteur du cadrage à la mise en ligne.
      </p>
      <div class="hero-acts">
        <a class="btn btn-primary" href="#rendez-vous" data-cta="hero-rendez-vous">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="3"/><path d="M16 2v4M8 2v4M3 10h18"/></svg>
          Réserver un appel
        </a>
        <a class="btn btn-ghost" href="#realisations" data-cta="hero-realisations">
          Voir les réalisations
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </a>
      </div>
      <p class="hero-note">Premier échange gratuit · Réponse sous 24h</p>
    </div>

    <div class="hero-visual" aria-hidden="true">
      <div class="hv-main cw">
        <div class="cw-bar"><div class="cw-d"><i></i><i></i><i></i></div><span class="cw-f">kmmterminal.com</span></div>
        <Image src={kmm} alt="" widths={[480, 720, 960]} sizes="(max-width: 960px) 92vw, 560px" loading="eager" fetchpriority="high" />
      </div>
      <div class="hv-phone">
        <Image src={bisou} alt="" widths={[240, 360]} sizes="180px" loading="eager" />
      </div>
      <div class="hv-result">
        <span class="hv-result-v">x2,4</span>
        <span class="hv-result-l">abonnés au terminal<br>KMM Trade Hub</span>
      </div>
      <div class="hv-person">
        <Image src={paul} alt="" width={96} height={96} class="hv-avatar" />
        <span><strong>Paul, fondateur</strong><br>Votre interlocuteur du début à la fin</span>
      </div>
    </div>
  </div>
</section>

<style>
  #hero{position:relative;overflow:hidden;padding:7rem 0 4rem;background:radial-gradient(ellipse 140% 90% at 50% -10%,#c2410c 0%,#9a3412 22%,#0a0a20 55%,var(--bg) 75%)}
  #hero::before{content:'';position:absolute;inset:0;background-image:radial-gradient(rgba(255,255,255,.06) 1px,transparent 1px);background-size:28px 28px;opacity:.5;pointer-events:none}
  .hero-grid{position:relative;z-index:1;display:grid;gap:3rem;align-items:center}
  .hero-copy{text-align:center}
  .hero-badge{display:inline-flex;align-items:center;gap:.55rem;background:rgba(255,255,255,.1);border:1px solid rgba(255,255,255,.2);color:rgba(255,255,255,.9);font-size:.74rem;font-weight:600;padding:.45rem 1rem;border-radius:100px;margin-bottom:1.6rem;backdrop-filter:blur(8px)}
  .hero-dot{width:8px;height:8px;border-radius:50%;background:var(--accent2);box-shadow:0 0 0 4px rgba(249,115,22,.25)}
  .hero-h1{font-family:'Bricolage Grotesque',sans-serif;font-weight:800;font-size:clamp(2.3rem,9.5vw,3.3rem);line-height:1.02;letter-spacing:-.035em;color:#fff;margin-bottom:1.3rem;text-wrap:balance}
  .hero-h1 em{font-style:normal;color:var(--accent2)}
  .hero-sub{font-size:1rem;line-height:1.7;color:rgba(255,255,255,.68);margin:0 auto 2rem;max-width:34rem}
  .hero-acts{display:flex;flex-direction:column;gap:.7rem;max-width:22rem;margin:0 auto .9rem}
  .hero-note{font-size:.74rem;color:rgba(255,255,255,.45)}

  .hero-visual{position:relative;max-width:560px;width:100%;margin:0 auto;padding:0 0 2.5rem}
  .hv-main{border-radius:1.4rem;box-shadow:0 40px 90px rgba(0,0,0,.65),0 0 0 1px rgba(249,115,22,.08)}
  .hv-main :global(img){width:100%;height:auto;aspect-ratio:16/10;object-fit:cover;object-position:top}
  .hv-phone{position:absolute;right:-.25rem;bottom:0;width:30%;aspect-ratio:9/17;border-radius:1.4rem;overflow:hidden;border:5px solid #16161f;box-shadow:0 25px 60px rgba(0,0,0,.6)}
  .hv-phone :global(img){width:100%;height:100%;object-fit:cover;object-position:28% top}
  .hv-result{position:absolute;left:-.25rem;top:58%;display:flex;align-items:center;gap:.7rem;background:rgba(10,10,18,.92);border:1px solid var(--accent-md);border-radius:1.2rem;padding:.7rem 1rem;box-shadow:0 20px 50px rgba(0,0,0,.55);backdrop-filter:blur(10px)}
  .hv-result-v{font-family:'Bricolage Grotesque',sans-serif;font-size:1.6rem;font-weight:800;color:var(--accent2);letter-spacing:-.03em}
  .hv-result-l{font-size:.68rem;line-height:1.35;color:rgba(255,255,255,.7)}
  .hv-person{position:absolute;left:8%;bottom:0;display:flex;align-items:center;gap:.65rem;background:#fff;color:#0a0a12;border-radius:100px;padding:.4rem 1rem .4rem .4rem;font-size:.68rem;line-height:1.3;box-shadow:0 20px 50px rgba(0,0,0,.5)}
  .hv-person strong{font-size:.76rem}
  .hv-person :global(.hv-avatar){width:42px;height:42px;border-radius:50%;object-fit:cover;object-position:50% 30%;flex-shrink:0}

  @media (min-width:600px){
    .hero-acts{flex-direction:row;justify-content:center;max-width:none}
  }
  @media (min-width:960px){
    #hero{min-height:100svh;display:flex;align-items:center;padding:8rem 0 5rem}
    .hero-grid{grid-template-columns:1.05fr 1fr;gap:4rem}
    .hero-copy{text-align:left}
    .hero-h1{font-size:clamp(3rem,4.6vw,4.4rem)}
    .hero-sub{margin-left:0;font-size:1.08rem}
    .hero-acts{justify-content:flex-start}
    .hv-result{left:-2rem}
  }
  @media (max-width:420px){
    .hv-person span{display:none}
    .hv-person{padding:.35rem}
  }
</style>
